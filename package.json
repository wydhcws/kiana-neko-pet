{
  "name": "kiana-neko-pet",
  "version": "1.0.0",
  "description": "二次元萌系 3D 猫娘桌面助手（琪亚娜风格同人）",
  "main": "main.js",
  "author": "wydhcws",
  "license": "MIT",
  "homepage": "https://github.com/wydhcws/kiana-neko-pet",
  "scripts": {
    "start": "electron .",
    "build:native": "node scripts/build-native.js",
    "icon": "node assets/make-icon.js",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win"
  },
  "dependencies": {
    "msedge-tts": "^2.0.7",
    "three": "0.169.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wydhcws.kiana-neko-pet",
    "productName": "琪亚娜猫娘",
    "copyright": "Copyright © 2026 wydhcws. Kiana Kaslana / Honkai Impact 3rd © miHoYo",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "asar": false,
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "voice.js",
      "lyrics.js",
      "ai.js",
      "src/**/*",
      "assets/icon.png",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!**/*.map",
      "!**/{test,tests,__tests__}/**",
      "!models/**",
      "!dist/**",
      "!KIANA_PET_REBUILD.md",
      "!native/**",
      "!bin/**",
      "!scripts/**",
      "!.github/**"
    ],
    "extraResources": [
      {
        "from": "models/README.md",
        "to": "models/README.md"
      },
      {
        "from": "node_modules/three/examples/jsm",
        "to": "app/node_modules/three/examples/jsm"
      },
      {
        "from": "models/Kiana Kaslana - Herrscher of Flamescion",
        "to": "app/models/Kiana Kaslana - Herrscher of Flamescion"
      },
      {
        "from": "models/Kiana Kaslana - Herrscher of Finality",
        "to": "app/models/Kiana Kaslana - Herrscher of Finality"
      },
      {
        "from": "models/Kiana Kaslana - World Diva",
        "to": "app/models/Kiana Kaslana - World Diva"
      },
      {
        "from": "models/琪亚娜 咚琪小礼裙",
        "to": "app/models/琪亚娜 咚琪小礼裙"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "assets/icon.png",
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": true
      },
      "extraFiles": [
        {
          "from": "bin/nowplaying",
          "to": "Resources/app/bin/nowplaying"
        },
        {
          "from": "native/mediaremote-adapter/bin/mediaremote-adapter.pl",
          "to": "Resources/app/native/mediaremote-adapter/bin/mediaremote-adapter.pl"
        },
        {
          "from": "native/mediaremote-adapter/build/MediaRemoteAdapter.framework",
          "to": "Resources/app/native/mediaremote-adapter/build/MediaRemoteAdapter.framework"
        },
        {
          "from": "native/mediaremote-adapter/LICENSE",
          "to": "Resources/app/native/mediaremote-adapter/LICENSE"
        }
      ]
    },
    "dmg": {
      "title": "琪亚娜猫娘 ${version}"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${name}-setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "琪亚娜猫娘"
    },
    "portable": {
      "artifactName": "${name}-${version}-portable.exe"
    }
  }
}
